# Copy to .env locally. Do not commit real secrets.
SCORERECORD_DB_PATH=data/scorerecord.db
SCORERECORD_RAW_DIR=data/raw

# Future paid/free APIs. Leave empty for Fase 0-1.
API_FOOTBALL_KEY=
ODDS_API_IO_KEY=
ODDS_API_IO_BASE_URL=https://api.odds-api.io/v3
# Names outside the account plan are dropped automatically (the free plan allows one).
ODDS_API_IO_BOOKMAKERS=Unibet
# Only used by fetch-odds for fixtures that did not come from odds-api.io
# (World Cup). Club fixtures carry their provider event id and need no slug.
ODDS_API_IO_LEAGUE=international-fifa-world-cup
SCORERECORD_DISPLAY_TZ=America/Mexico_City
THESTATSAPI_KEY=
THESTATSAPI_BASE_URL=https://api.thestatsapi.com/api
SPORTMONKS_API_TOKEN=
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football
BALLDONTLIE_KEY=
