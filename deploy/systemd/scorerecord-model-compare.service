[Unit]
Description=ScoreRecord monthly model comparison (evidence only, publishes nothing)
OnFailure=scorerecord-notify@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/adrian/scorerecord
EnvironmentFile=/home/adrian/scorerecord/.env
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
MemoryMax=600M
Nice=15
IOSchedulingClass=idle
# Refreshes the "Comparación de modelos" table on the dashboard. Changing the
# production settings stays a manual step: model-compare --write-params.
ExecStart=/home/adrian/scorerecord/.venv/bin/scorerecord model-compare
