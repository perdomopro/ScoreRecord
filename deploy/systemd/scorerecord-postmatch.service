[Unit]
Description=ScoreRecord post-match results and settlement

[Service]
Type=oneshot
WorkingDirectory=/home/adrian/scorerecord
EnvironmentFile=/home/adrian/scorerecord/.env
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
MemoryMax=400M
Nice=10
IOSchedulingClass=idle
ExecStart=/bin/sh -c '/home/adrian/scorerecord/.venv/bin/scorerecord ingest-results; /home/adrian/scorerecord/.venv/bin/scorerecord settle-fixtures && /home/adrian/scorerecord/.venv/bin/scorerecord settle-forecast-snapshots'
