[Unit]
Description=ScoreRecord post-match settlement and CLV

[Service]
Type=oneshot
WorkingDirectory=/home/adrian/scorerecord
EnvironmentFile=/home/adrian/scorerecord/.env
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
MemoryMax=700M
Nice=10
IOSchedulingClass=idle
ExecStart=/bin/sh -lc '/home/adrian/scorerecord/.venv/bin/scorerecord settle-fixtures && /home/adrian/scorerecord/.venv/bin/scorerecord compute-clv'
