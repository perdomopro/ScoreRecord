[Unit]
Description=ScoreRecord pre-play raw odds snapshot fetch

[Service]
Type=oneshot
WorkingDirectory=/home/adrian/scorerecord
EnvironmentFile=/home/adrian/scorerecord/.env
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
MemoryMax=700M
Nice=10
IOSchedulingClass=idle
ExecStart=/home/adrian/scorerecord/.venv/bin/scorerecord fetch-odds --preplay-window-minutes 60
