[Unit]
Description=ScoreRecord daily EPL pilot refresh

[Service]
Type=oneshot
WorkingDirectory=/home/adrian/scorerecord
EnvironmentFile=/home/adrian/scorerecord/.env
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
MemoryMax=900M
Nice=10
IOSchedulingClass=idle

# DO NOT ENABLE AUTOMATICALLY. Requires manual approval.
ExecStart=/bin/bash /home/adrian/scorerecord/scripts/run_daily_epl_pilot.sh
