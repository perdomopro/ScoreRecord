[Unit]
Description=ScoreRecord forecast and health dashboard
OnFailure=scorerecord-notify@%n.service
After=network-online.target
# Keep retrying: at boot the tailnet address may appear after the service starts.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/adrian/scorerecord
EnvironmentFile=/home/adrian/scorerecord/.env
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
# Uses about 60 MB; at most half a core so other services keep the machine.
CPUQuota=50%
MemoryMax=200M
Nice=10
IOSchedulingClass=idle
# Address from SCORERECORD_GUI_HOST in .env (the tailnet IP); 127.0.0.1 if unset.
ExecStart=/home/adrian/scorerecord/.venv/bin/scorerecord gui --port 8765
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
